rules_version = '2';
// Çevrimiçi katmanın güvenlik kuralları. Firebase konsolunda
// Firestore > Rules bölümüne yapıştırılır (ya da `firebase deploy --only firestore`).
// Testler: firebase/test/rules.test.mjs (Firestore emülatörü; CI: firestore-rules.yml).
//
// İlkeler: oturum açmamış istek hiçbir şeye erişemez; herkes yalnızca kendi
// belgelerini yazar; her yazımda alan listesi, tür ve boyut sınırı denetlenir;
// listeleme (toplu okuma) yalnızca gereken yerlerde açıktır. Skor, puan ve
// hamle doğruluğu istemciye güvenir: bkz. SECURITY_AUDIT.md (Cloud Functions).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function optInt(d, k, lo, hi) { return !(k in d) || (d[k] is int && d[k] >= lo && d[k] < hi); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function nowStamp(v) { return v == request.time; }

    // ---------------------------------------------------------------- profil
    // Profil: oturum açan herkes tek tek okur (ad, avatar, lig); listeleme yok.
    // Yalnızca sahibi yazar ve siler. Başkası yalnızca hediye sayacını,
    // katalogdaki tek bir hediye için tam 1 artırabilir.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'avatar', 'age16', 'terms', 'active', 'vip', 'table',
                               'code', 'rating', 'gifts', 'blocked', 'created'])
          && (!('uid' in d) || d.uid == uid)
          && str(d.name, 16)
          && optInt(d, 'avatar', 0, 1000)
          && optBool(d, 'age16')
          && optInt(d, 'terms', 0, 100000)
          && optStr(d, 'active', 64)
          && optBool(d, 'vip')
          && optStr(d, 'table', 64)
          && optStr(d, 'code', 12)
          && (!('rating' in d) || (d.rating is map && d.rating.size() <= 500))
          && (!('gifts' in d) || (d.gifts is map && d.gifts.size() <= 20))
          && (!('blocked' in d) || (d.blocked is list && d.blocked.size() <= 500));
    }
    function giftStep(n, o, k) { return n.get(k, 0) == o.get(k, 0) || n.get(k, 0) == o.get(k, 0) + 1; }
    function giftOnly() {
      let o = resource.data.get('gifts', {});
      let n = request.resource.data.get('gifts', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gifts'])
          && n is map
          && n.diff(o).affectedKeys().size() == 1
          && n.diff(o).affectedKeys().hasOnly(['coffee', 'tea', 'applause', 'rose', 'cake', 'trophy', 'crown'])
          && n.diff(o).removedKeys().size() == 0
          && giftStep(n, o, 'coffee') && giftStep(n, o, 'tea') && giftStep(n, o, 'applause')
          && giftStep(n, o, 'rose') && giftStep(n, o, 'cake') && giftStep(n, o, 'trophy')
          && giftStep(n, o, 'crown');
    }
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if me(uid) && validProfile(uid);
      // Arkadaş kodu bir kez verilir, sonra değişmez.
      allow update: if me(uid) && validProfile(uid)
                    && request.resource.data.get('code', '') == resource.data.get('code', '');
      allow update: if signedIn() && !me(uid) && giftOnly();
      allow delete: if me(uid);

      // Arkadaşlık iki yönlü yazılır (arkadaş kodunu giren kişi iki belgeyi de yazar).
      match /friends/{fuid} {
        allow read: if me(uid);
        allow create, update: if (me(uid) || me(fuid)) && uid != fuid
                              && request.resource.data.keys().hasOnly(['at'])
                              && nowStamp(request.resource.data.at);
        allow delete: if me(uid) || me(fuid);
      }
      // Masa daveti: yalnızca arkadaş listesindekiler gönderebilir.
      match /invites/{i} {
        allow read, delete: if me(uid);
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
                      && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid))
                      && request.resource.data.keys().hasOnly(['from', 'name', 'avatar', 'gameId', 'code', 'at', 'ts'])
                      && str(request.resource.data.code, 8)
                      && optStr(request.resource.data, 'name', 16)
                      && optStr(request.resource.data, 'gameId', 64)
                      && optInt(request.resource.data, 'avatar', 0, 1000)
                      && request.resource.data.at is int
                      && nowStamp(request.resource.data.ts);
      }
    }

    // Arkadaş kodu → uid. Kod bilinerek tek tek okunur; listeleme (bütün
    // kullanıcıları sayma) yok.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{4,12}$')
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Bulut kayıt: yalnızca sahibi okur/yazar.
    match /saves/{uid}/blobs/{key} {
      allow read, delete: if me(uid);
      allow create, update: if me(uid) && key.size() <= 128
                            && request.resource.data.keys().hasOnly(['v', 'ts'])
                            && request.resource.data.v is string
                            && request.resource.data.v.size() < 900000;
    }

    // Skor tabloları: herkes okur; herkes yalnızca kendi skorunu, yalnızca
    // yukarı doğru yazar. (Skorun gerçekliği istemciye güvenir.)
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['score', 'name', 'avatar', 'ts'])
          && d.score is int && d.score >= 0 && d.score < 100000000
          && optStr(d, 'name', 16)
          && optInt(d, 'avatar', 0, 1000)
          && (!('ts' in d) || nowStamp(d.ts));
    }
    match /boards/{board}/scores/{uid} {
      allow read: if signedIn();
      allow create: if me(uid) && board.size() <= 64 && validScore();
      allow update: if me(uid) && validScore() && request.resource.data.score >= resource.data.score;
      allow delete: if me(uid);
    }

    // ------------------------------------------------------------------ maçlar
    function matchDoc(id) { return get(/databases/$(db)/documents/matches/$(id)).data; }
    function member(id) { return signedIn() && request.auth.uid in matchDoc(id).uids; }
    function beatsOnlyMine() {
      return request.resource.data.get('beats', {}).diff(resource.data.get('beats', {})).affectedKeys()
               .hasOnly([request.auth.uid]);
    }
    function validNewMatch() {
      let d = request.resource.data;
      return d.keys().hasOnly(['gameId', 'size', 'seed', 'code', 'private', 'host', 'status', 'seats',
                               'uids', 'rating', 'created', 'beats'])
          && d.host == request.auth.uid
          && d.uids == [request.auth.uid]
          && d.seats is list && d.seats.size() == 1 && d.seats[0].uid == request.auth.uid
          && d.status == 'waiting'
          && d.size is int && d.size >= 1 && d.size <= 16
          && str(d.gameId, 64) && str(d.code, 12)
          && d.private is bool && d.seed is int
          && optInt(d, 'rating', 0, 100000)
          && nowStamp(d.created)
          && d.beats.keys().hasOnly([request.auth.uid]);
    }
    // Masadakiler: kalp atışı (yalnız kendi), botla doldurma, bitirme.
    // Koltuklar yalnızca sona eklenir; ev sahibi, oyun, tohum, kod değişmez;
    // bitmiş maç yeniden açılmaz.
    function memberUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      return n.diff(o).affectedKeys().hasOnly(['seats', 'status', 'winner', 'beats'])
          && beatsOnlyMine()
          && n.status in ['waiting', 'playing', 'done']
          && (o.status != 'done' || n.status == 'done')
          && n.seats is list && n.seats.size() >= o.seats.size() && n.seats.size() <= o.size
          && n.seats[0:o.seats.size()] == o.seats
          && (!('winner' in n) || n.winner is int);
    }
    // Katılma: bekleyen masaya, kendi koltuğunu sona ekleyerek.
    function joinUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      let k = o.seats.size();
      return o.status == 'waiting'
          && n.diff(o).affectedKeys().hasOnly(['seats', 'uids', 'beats', 'status'])
          && n.uids == o.uids.concat([request.auth.uid])
          && n.seats is list && n.seats.size() == k + 1 && k + 1 <= o.size
          && n.seats[0:k] == o.seats
          && n.seats[k].uid == request.auth.uid
          && beatsOnlyMine()
          && (n.status == 'waiting' || (n.status == 'playing' && k + 1 == o.size));
    }
    match /matches/{id} {
      // Maç kimliği tahmin edilemez: tek tek okunur. Listeleme yalnızca herkese
      // açık masalar (lobi, hızlı eşleşme) ya da oturulan masalar için.
      // Özel masaların kodu bu yüzden listelenemez (kodla katılım: matchCodes).
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.private == false || request.auth.uid in resource.data.uids);
      allow create: if signedIn() && validNewMatch();
      allow update: if signedIn() && request.auth.uid in resource.data.uids && memberUpdate();
      allow update: if signedIn() && !(request.auth.uid in resource.data.uids) && joinUpdate();

      match /moves/{mv} {
        allow read: if signedIn();
        // Hamleler değiştirilemez ve silinemez.
        allow create: if member(id)
                      && mv.matches('^[0-9]{6}$')
                      && request.resource.data.keys().hasOnly(['n', 'seat', 'move', 'by', 'ts'])
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.n is int && request.resource.data.n >= 0
                      && request.resource.data.seat is int && request.resource.data.seat >= 0
                      && request.resource.data.seat < 16
                      && str(request.resource.data.move, 4000)
                      && nowStamp(request.resource.data.ts);
      }
      // Gerçek zamanlı oyunlar (lib/online/live_ring.dart): koltuk başına
      // {koltuk}_{yuva} adlı en çok 10 belgelik halka; yuvaların üzerine yazılır.
      // Her belgede expireAt vardır (en çok 1 gün sonrası); Firestore TTL ilkesi
      // (firestore.indexes.json → fieldOverrides: live.expireAt ttl) terk edilmiş
      // maçların belgelerini siler. Maç bitince masadakiler halkayı siler.
      match /live/{p} {
        function validLive() {
          let d = request.resource.data;
          return d.keys().hasOnly(['seat', 'seq', 'd', 'by', 'expireAt'])
              && d.by == request.auth.uid
              && d.seat is int && d.seat >= 0 && d.seat < 16
              && p.matches('^[0-9]{1,2}_[0-9]$') && p.split('_')[0] == string(d.seat)
              && d.seq is int
              && d.d is string && d.d.size() <= 4000
              && d.expireAt is timestamp && d.expireAt <= request.time + duration.value(1, 'd');
        }
        allow read: if signedIn();
        allow create, update: if member(id) && validLive();
        allow delete: if member(id);
      }
      // Masa sohbeti ve hediyeler. Serbest metin ('t') yalnızca profilinde 16+
      // işaretli oyuncudan ve en çok 120 karakter; hazır mesaj ('p') ve hediye
      // ('g') kısa kimliklerdir.
      match /events/{e} {
        allow read: if signedIn();
        allow create: if member(id)
                      && request.resource.data.keys().hasOnly(['seat', 'kind', 'value', 'to', 'by', 'ts'])
                      && request.resource.data.by == request.auth.uid
                      && request.resource.data.kind in ['p', 't', 'g']
                      && request.resource.data.seat is int
                      && optInt(request.resource.data, 'to', -1, 16)
                      && str(request.resource.data.value, request.resource.data.kind == 't' ? 120 : 64)
                      && (request.resource.data.kind != 't'
                          || get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('age16', false) == true)
                      && nowStamp(request.resource.data.ts);
      }
    }

    // Özel masa kodu → maç kimliği. Kodu bilen tek tek okur; listeleme yok.
    // Yalnızca o maçın ev sahibi, maçtaki kodla yazabilir. TTL: expireAt.
    match /matchCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{4,12}$')
                    && request.resource.data.keys().hasOnly(['match', 'by', 'expireAt'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.match is string
                    && matchDoc(request.resource.data.match).host == request.auth.uid
                    && matchDoc(request.resource.data.match).code == code
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt <= request.time + duration.value(2, 'd');
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // Telefon değişimi: kodu bilen (12 karakter, güvenli rastgele) tek tek okur;
    // üst belgede listeleme yok. TTL: expireAt (en çok 7 gün).
    match /transfers/{code} {
      allow get, delete: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{12}$')
                    && request.resource.data.keys().hasOnly(['by', 'profile', 'created', 'expireAt'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.profile is map
                    && request.resource.data.profile.size() <= 20
                    && nowStamp(request.resource.data.created)
                    && (!('expireAt' in request.resource.data)
                        || (request.resource.data.expireAt is timestamp
                            && request.resource.data.expireAt <= request.time + duration.value(7, 'd')));
      match /blobs/{key} {
        allow get, list, delete: if signedIn();
        allow create: if signedIn()
                      && get(/databases/$(db)/documents/transfers/$(code)).data.by == request.auth.uid
                      && key.size() <= 128
                      && request.resource.data.keys().hasOnly(['v'])
                      && request.resource.data.v is string
                      && request.resource.data.v.size() < 900000;
      }
    }

    // Şikâyetler: yalnızca yazılır; Firebase konsolundan okunur.
    match /reports/{r} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['by', 'target', 'reason', 'match', 'text', 'ts'])
                    && request.resource.data.by == request.auth.uid
                    && str(request.resource.data.target, 128)
                    && str(request.resource.data.reason, 32)
                    && optStr(request.resource.data, 'match', 64)
                    && optStr(request.resource.data, 'text', 500)
                    && nowStamp(request.resource.data.ts);
    }
  }
}
