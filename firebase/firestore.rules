rules_version = '2';
// Çevrimiçi katmanın güvenlik kuralları. Firebase konsolunda
// Firestore > Rules bölümüne yapıştırılır (ya da `firebase deploy --only firestore`).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    // Profil: herkes okur (ad, avatar, lig); yalnızca sahibi yazar.
    // Başkası yalnızca hediye sayacını artırabilir.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if me(uid) && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gifts']);
      match /friends/{fuid} {
        allow read: if me(uid);
        allow write: if me(uid) || me(fuid);
      }
      // Masa daveti: yalnızca arkadaş listesindekiler gönderebilir.
      match /invites/{i} {
        allow read, delete: if me(uid);
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
                      && exists(/databases/$(db)/documents/users/$(uid)/friends/$(request.auth.uid))
                      && request.resource.data.code is string && request.resource.data.code.size() <= 8;
      }
    }
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /saves/{uid}/blobs/{key} {
      allow read, write: if me(uid) && (request.resource == null || request.resource.data.v.size() < 900000);
    }
    match /boards/{board}/scores/{uid} {
      allow read: if signedIn();
      allow write: if me(uid) && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score < 100000000;
    }
    match /matches/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      // Masadakiler ya da katılmak isteyen herkes (koltuk ekleme) günceller.
      allow update: if signedIn() && (request.auth.uid in resource.data.uids || request.auth.uid in request.resource.data.uids);
      match /moves/{n} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid in get(/databases/$(db)/documents/matches/$(id)).data.uids
                      && request.resource.data.by == request.auth.uid;
      }
      // Gerçek zamanlı oyunlar (lib/online/live_ring.dart): koltuk başına
      // {koltuk}_{yuva} adlı en çok 10 belgelik halka; yuvaların üzerine yazılır.
      // Her belgede expireAt vardır (en çok 1 gün sonrası); Firestore TTL ilkesi
      // (firestore.indexes.json → fieldOverrides: live.expireAt ttl) terk edilmiş
      // maçların belgelerini siler. Maç bitince masadakiler halkayı siler.
      match /live/{p} {
        function member() {
          return signedIn() && request.auth.uid in get(/databases/$(db)/documents/matches/$(id)).data.uids;
        }
        function validLive() {
          let d = request.resource.data;
          return d.keys().hasOnly(['seat', 'seq', 'd', 'by', 'expireAt'])
              && d.by == request.auth.uid
              && d.seat is int && d.seat >= 0 && d.seat < 16
              && p.matches('^[0-9]{1,2}_[0-9]$') && p.split('_')[0] == string(d.seat)
              && d.seq is int
              && d.d is string && d.d.size() <= 4000
              && d.expireAt is timestamp && d.expireAt <= request.time + duration.value(1, 'd');
        }
        allow read: if signedIn();
        allow create, update: if member() && validLive();
        allow delete: if member();
      }
      match /events/{e} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid in get(/databases/$(db)/documents/matches/$(id)).data.uids
                      && request.resource.data.by == request.auth.uid
                      && (request.resource.data.kind != 't' || request.resource.data.value.size() <= 120);
      }
    }
    // Telefon değişimi: kodu bilen (12 karakter, tahmin edilemez) tek tek okur; listeleme yok.
    match /transfers/{code} {
      allow get, delete: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      match /blobs/{key} {
        allow get, delete: if signedIn();
        allow list: if signedIn();
        allow create: if signedIn() && get(/databases/$(db)/documents/transfers/$(code)).data.by == request.auth.uid;
      }
    }
    // Şikâyetler: yalnızca yazılır; Firebase konsolundan okunur.
    match /reports/{r} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
    }
  }
}
